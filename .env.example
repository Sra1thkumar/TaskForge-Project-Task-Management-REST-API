# WorkFlow Pro Configuration

PROJECT_NAME="WorkFlow Pro"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT Tokens (Generate a secure key with: openssl rand -hex 32)
SECRET_KEY="replace-this-with-a-random-secret-key-for-jwt-signing"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite (Local Development default):
DATABASE_URL="sqlite:///./workflow_pro.db"
# PostgreSQL (Production / Docker Compose):
# DATABASE_URL="postgresql+psycopg://workflow_user:workflow_secret@localhost:5432/workflow_pro"

# Redis & Celery Background Workers
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# CORS Configuration
BACKEND_CORS_ORIGINS=["*"]

# Email Notifications (Optional SMTP configuration)
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL="noreply@workflowpro.io"
EMAILS_FROM_NAME="WorkFlow Pro Notifications"
